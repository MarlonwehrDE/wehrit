---
import PageLayout from '../layouts/PageLayout.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import GlassButton from '../components/ui/GlassButton.astro';
import { contact } from '../config/contact';
---

<PageLayout
  title="Kontakt"
  headline="Lass uns reden."
  subtitle="Schreib mir eine Nachricht und ich melde mich innerhalb von 24 Stunden."
>
  <div class="contact-grid">
    <GlassCard level="medium" interactive class="contact-form-card" data-reveal>
      <form class="contact-form" method="POST" action="#">
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required class="glass-input" placeholder="Dein Name" />
        </div>
        <div class="form-group">
          <label for="email">E-Mail</label>
          <input type="email" id="email" name="email" required class="glass-input" placeholder="deine@email.de" />
        </div>
        <div class="form-group">
          <label for="subject">Betreff</label>
          <select id="subject" name="subject" class="glass-input">
            <option value="webdesign">Webdesign</option>
            <option value="software">Softwareentwicklung</option>
            <option value="e-rechnung">E-Rechnung</option>
            <option value="sonstiges">Sonstiges</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">Nachricht</label>
          <textarea id="message" name="message" rows="5" required class="glass-input" placeholder="Erzähl mir von deinem Projekt..."></textarea>
        </div>
        <GlassButton variant="primary">Nachricht senden</GlassButton>
      </form>
    </GlassCard>

    <div class="contact-info" data-reveal>
      <GlassCard level="thin" interactive>
        <h3>Direkt schreiben</h3>
        <a href={`mailto:${contact.email}`} class="contact-link">{contact.email}</a>
      </GlassCard>
      <GlassCard level="thin" interactive>
        <h3>Anrufen</h3>
        <a href={`tel:${contact.phoneRaw}`} class="contact-link">{contact.phone}</a>
      </GlassCard>
      <GlassCard level="thin" interactive>
        <h3>Standort</h3>
        <p>{contact.city}, {contact.country}</p>
      </GlassCard>
    </div>
  </div>
</PageLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .glass-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--glass-bg-thin);
    border: 1px solid var(--glass-border-medium);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-base);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow:
      inset 0 1px 0 0 var(--glass-inner-glow),
      inset 0 0 0 1px var(--glass-edge-glow);
    transition:
      border-color var(--duration-fast) var(--ease-glass),
      box-shadow var(--duration-fast) var(--ease-glass);
    outline: none;
  }

  .glass-input:focus {
    border-color: var(--color-primary-400);
    box-shadow:
      inset 0 1px 0 0 var(--glass-inner-glow),
      inset 0 0 0 1px var(--glass-edge-glow),
      0 0 0 3px rgba(124, 110, 224, 0.15),
      0 0 16px 0 rgba(124, 110, 224, 0.08);
  }

  .glass-input::placeholder {
    color: var(--color-text-muted);
  }

  textarea.glass-input {
    resize: vertical;
    min-height: 120px;
  }

  select.glass-input {
    cursor: pointer;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-info h3 {
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .contact-info p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .contact-link {
    font-size: var(--text-sm);
    color: var(--color-primary-400);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-glass);
  }

  .contact-link:hover {
    color: var(--color-primary-300);
  }
</style>
