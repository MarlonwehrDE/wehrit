---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  magnetic?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  href,
  magnetic = true,
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const attrs: Record<string, any> = { ...rest };
if (href) attrs.href = href;
if (magnetic) attrs['data-magnetic'] = '0.12';
attrs['data-ripple'] = '';
---

<Tag class:list={[`btn btn-${variant}`, className]} {...attrs}>
  <span class="btn-specular" />
  <span class="btn-content">
    <slot />
  </span>
  <span class="btn-shine" />
</Tag>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0.85rem 2rem;
    min-height: 48px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--text-base);
    letter-spacing: var(--tracking-wide);
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    transition:
      transform var(--duration-normal) var(--ease-spring),
      box-shadow var(--duration-normal) var(--ease-glass);
  }

  .btn-specular {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 70%;
    height: 20px;
    background: radial-gradient(
      ellipse 100% 100% at 50% 0%,
      var(--glass-specular-color),
      transparent
    );
    filter: blur(10px);
    pointer-events: none;
    z-index: 1;
  }

  .btn-content {
    position: relative;
    z-index: 2;
  }

  .btn-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.20) 45%,
      rgba(255, 255, 255, 0.10) 50%,
      transparent 55%
    );
    z-index: 1;
    transform: translateX(-100%);
    transition: transform 0.6s var(--ease-out);
    pointer-events: none;
  }

  .btn:hover .btn-shine {
    transform: translateX(100%);
  }

  /* Primary */
  .btn-primary {
    background: linear-gradient(
      135deg,
      var(--color-primary-400),
      var(--color-primary-600)
    );
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 4px 24px -4px rgba(124, 110, 224, 0.5),
      0 0 0 1px rgba(124, 110, 224, 0.15);
  }

  .btn-primary:hover {
    box-shadow:
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.45),
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 8px 40px -4px rgba(124, 110, 224, 0.65),
      0 0 24px 0 rgba(124, 110, 224, 0.25);
  }

  /* Secondary */
  .btn-secondary {
    background: var(--glass-bg-medium);
    color: var(--color-text);
    border: 1px solid var(--glass-border-medium);
    backdrop-filter: blur(var(--glass-blur-thick));
    -webkit-backdrop-filter: blur(var(--glass-blur-thick));
    box-shadow:
      inset 0 1px 0 0 var(--glass-highlight),
      inset 0 0 0 1px var(--glass-edge-glow),
      0 4px 16px -4px var(--glass-shadow);
  }

  .btn-secondary:hover {
    background: var(--glass-bg-thick);
    border-color: var(--glass-border-strong);
    box-shadow:
      inset 0 1px 1px 0 var(--glass-highlight),
      inset 0 0 0 1px var(--glass-edge-glow),
      0 8px 32px -4px var(--glass-shadow),
      0 0 16px 0 rgba(124, 110, 224, 0.10);
  }

  /* Ghost */
  .btn-ghost {
    background: transparent;
    color: var(--color-primary-300);
    border: 1px solid transparent;
  }

  .btn-ghost:hover {
    background: var(--glass-bg-thin);
    border-color: var(--glass-border-subtle);
  }

  @media (max-width: 768px) {
    .btn {
      padding: 0.75rem 1.5rem;
      font-size: var(--text-sm);
    }
  }

  @media (max-width: 480px) {
    .btn {
      padding: 0.7rem 1.25rem;
      width: 100%;
    }
  }
</style>
