---
import GlassButton from './ui/GlassButton.astro';
import LiquidBlob from './fx/LiquidBlob.astro';
import HeroVisual from './HeroVisual.astro';
---

<section class="hero">
  <LiquidBlob color="var(--color-primary-400)" size="700px" top="-15%" left="-10%" opacity="0.6" speed={0.8} />
  <LiquidBlob color="var(--color-primary-200)" size="500px" top="10%" right="-5%" opacity="0.4" speed={1.2} />
  <LiquidBlob color="var(--color-iris-pink)" size="400px" bottom="-10%" left="40%" opacity="0.25" speed={1} />

  <div class="hero-grid container" data-reveal>
    <div class="hero-content">
      <span class="hero-badge glass-thin">Its-A-One-Man-Show &middot; seit 2020</span>
      <h1 class="hero-title">
        Dein IT-Partner.<br />
        <span class="hero-typed-wrap">
          <span class="hero-typed" id="hero-typed"></span>
          <span class="hero-cursor">|</span>
        </span>
      </h1>
      <p class="hero-subtitle">
        Fullstack-Entwicklung, Webdesign, Automatisierung und E-Rechnung — persönlich, direkt und ohne Agentur-Overhead.
      </p>
      <div class="hero-actions">
        <GlassButton variant="primary" data-contact-modal>
          Projekt besprechen
        </GlassButton>
        <GlassButton href="/#leistungen" variant="secondary">
          Leistungen entdecken
        </GlassButton>
      </div>
    </div>

    <div class="hero-visual-col">
      <HeroVisual />
    </div>

    <div class="hero-trust">
      <div class="trust-item glass-thin">
        <span class="trust-icon">🤝</span>
        <span class="trust-text">Persönlich & Direkt</span>
      </div>
      <div class="trust-item glass-thin">
        <span class="trust-icon">🎓</span>
        <span class="trust-text">Siemens ausgebildet</span>
      </div>
      <div class="trust-item glass-thin">
        <span class="trust-icon">🔧</span>
        <span class="trust-text">Freie Technologiewahl</span>
      </div>
    </div>
  </div>

  <div class="hero-scroll-indicator" id="hero-scroll">
    <div class="scroll-line"></div>
    <span class="scroll-text">Scroll</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: visible;
    padding-top: var(--space-24);
    padding-bottom: var(--space-16);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 3fr 2fr;
    }

    .hero-trust {
      grid-column: 1 / -1;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-visual-col {
    display: flex;
    justify-content: center;
    align-items: center;
    order: -1;
  }

  @media (min-width: 768px) {
    .hero-visual-col {
      order: 0;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary-300);
    width: fit-content;
    border-radius: var(--radius-pill);
  }

  .hero-title {
    font-size: var(--text-hero);
    font-weight: 900;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    max-width: 900px;
    background: linear-gradient(
      135deg,
      var(--color-text) 0%,
      var(--color-text) 40%,
      var(--color-primary-300) 70%,
      var(--color-primary-400) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-typed-wrap {
    display: inline-flex;
    align-items: baseline;
    min-height: 1.1em;
  }

  .hero-typed {
    background: linear-gradient(
      135deg,
      var(--color-iris-cyan),
      var(--color-iris-blue) 50%,
      var(--color-primary-300)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
  }

  .hero-cursor {
    display: inline-block;
    color: var(--color-primary-300);
    font-weight: 200;
    animation: cursor-blink 0.8s step-end infinite;
    margin-left: 2px;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
    line-height: var(--leading-normal);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .trust-icon {
    font-size: 1rem;
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    opacity: 0.5;
    transition: opacity var(--duration-normal) var(--ease-glass);
  }

  .hero-scroll-indicator:hover {
    opacity: 1;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-primary-400), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { transform: scaleY(1); opacity: 0.5; }
    50% { transform: scaleY(0.6); opacity: 1; }
  }

  .scroll-text {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
    }
    .hero-scroll-indicator {
      display: none;
    }
  }
</style>

<script>
  const typed = document.getElementById("hero-typed")!;
  const words = ["Webdesign.", "Software.", "E-Rechnung.", "Automatisierung."];
  let wordIdx = 0;
  let charIdx = 0;
  let deleting = false;

  function tick() {
    const current = words[wordIdx];
    if (!deleting) {
      typed.textContent = current.slice(0, ++charIdx);
      if (charIdx === current.length) {
        setTimeout(() => { deleting = true; tick(); }, 2000);
        return;
      }
      setTimeout(tick, 80 + Math.random() * 40);
    } else {
      typed.textContent = current.slice(0, --charIdx);
      if (charIdx === 0) {
        deleting = false;
        wordIdx = (wordIdx + 1) % words.length;
        setTimeout(tick, 400);
        return;
      }
      setTimeout(tick, 40);
    }
  }

  setTimeout(tick, 800);

  const scrollIndicator = document.getElementById("hero-scroll")!;
  window.addEventListener("scroll", () => {
    if (window.scrollY > 100) {
      scrollIndicator.style.opacity = "0";
      scrollIndicator.style.pointerEvents = "none";
    } else {
      scrollIndicator.style.opacity = "";
      scrollIndicator.style.pointerEvents = "";
    }
  }, { passive: true });
</script>
