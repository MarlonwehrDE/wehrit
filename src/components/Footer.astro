---
const year = new Date().getFullYear();

const links = [
  { label: 'Impressum', href: '/impressum' },
  { label: 'Datenschutz', href: '/datenschutz' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-logo-text">
        <span class="footer-logo-wehr">WEHR</span><span class="footer-logo-it">IT</span>
      </span>
      <p class="footer-tagline">Webdevelopment, Softwareentwicklung & E-Rechnung</p>
    </div>
    <div class="footer-theme-toggle">
      <button id="theme-toggle" class="theme-toggle" aria-label="Theme wechseln" type="button">
        <svg class="theme-icon theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="theme-icon theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
    <nav class="footer-links">
      {links.map((link) => (
        <a href={link.href} class="footer-link">{link.label}</a>
      ))}
    </nav>
    <p class="footer-copy">&copy; {year} WehrIT. Alle Rechte vorbehalten.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: var(--space-16) 0 var(--space-8);
    border-top: none;
    background-image: linear-gradient(to right, transparent, var(--glass-border-subtle) 20%, var(--glass-border-subtle) 80%, transparent);
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: top;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
  }

  .footer-logo-text {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.6rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1;
    opacity: 0.85;
    user-select: none;
  }

  .footer-logo-wehr {
    color: var(--color-text);
  }

  .footer-logo-it {
    color: var(--color-primary-400);
    position: relative;
    margin-left: 0.2em;
  }

  .footer-logo-it::after {
    content: "";
    position: absolute;
    bottom: -3px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary-400);
    border-radius: 1px;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .footer-links {
    display: flex;
    gap: var(--space-6);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-glass);
  }

  .footer-link:hover {
    color: var(--color-text);
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-theme-toggle {
    display: flex;
    justify-content: center;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--glass-bg-medium);
    border: 1px solid var(--glass-border-medium);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(var(--glass-blur-thin));
    -webkit-backdrop-filter: blur(var(--glass-blur-thin));
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-glass),
      border-color var(--duration-fast) var(--ease-glass),
      color var(--duration-fast) var(--ease-glass),
      box-shadow var(--duration-fast) var(--ease-glass);
    box-shadow:
      inset 0 1px 0 0 var(--glass-inner-glow),
      0 2px 8px -2px var(--glass-shadow);
  }

  .theme-toggle:hover {
    background: var(--glass-bg-thick);
    border-color: var(--glass-border-strong);
    color: var(--color-primary-300);
    box-shadow:
      inset 0 1px 0 0 var(--glass-highlight),
      0 4px 16px -4px var(--glass-shadow),
      0 0 12px 0 rgba(124, 110, 224, 0.10);
  }

  .theme-icon-moon {
    display: none;
  }

  :global([data-theme="light"]) .theme-icon-sun {
    display: none;
  }

  :global([data-theme="light"]) .theme-icon-moon {
    display: block;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle")!;
  btn.addEventListener("click", () => {
    const html = document.documentElement;
    const current = html.getAttribute("data-theme");
    const isDark = !current
      ? window.matchMedia("(prefers-color-scheme: light)").matches
        ? false
        : true
      : current === "dark";
    const next = isDark ? "light" : "dark";
    html.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
  });
</script>
