---
---

<div class="gradient-mesh" aria-hidden="true">
  <div class="mesh-layer mesh-1" />
  <div class="mesh-layer mesh-2" />
  <div class="mesh-layer mesh-3" />
  <div class="mesh-layer mesh-4" />
</div>

<style>
  .gradient-mesh {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
  }

  .mesh-layer {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
    will-change: transform;
  }

  .mesh-1 {
    width: 60vw;
    height: 60vw;
    max-width: 800px;
    max-height: 800px;
    top: -10%;
    left: -10%;
    background: radial-gradient(circle, rgba(124, 110, 224, 0.5) 0%, transparent 70%);
    animation: mesh-drift-1 var(--liquid-drift) ease-in-out infinite alternate;
  }

  .mesh-2 {
    width: 50vw;
    height: 50vw;
    max-width: 700px;
    max-height: 700px;
    top: 5%;
    right: -15%;
    background: radial-gradient(circle, rgba(167, 155, 240, 0.4) 0%, transparent 70%);
    animation: mesh-drift-2 calc(var(--liquid-drift) * 1.3) ease-in-out infinite alternate;
  }

  .mesh-3 {
    width: 55vw;
    height: 55vw;
    max-width: 750px;
    max-height: 750px;
    bottom: -10%;
    left: 30%;
    background: radial-gradient(circle, rgba(232, 121, 168, 0.3) 0%, transparent 70%);
    animation: mesh-drift-3 calc(var(--liquid-drift) * 0.9) ease-in-out infinite alternate;
  }

  .mesh-4 {
    width: 45vw;
    height: 45vw;
    max-width: 600px;
    max-height: 600px;
    bottom: 20%;
    left: -5%;
    background: radial-gradient(circle, rgba(110, 231, 200, 0.2) 0%, transparent 70%);
    animation: mesh-drift-4 calc(var(--liquid-drift) * 1.1) ease-in-out infinite alternate;
  }

  @keyframes mesh-drift-1 {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(8%, 5%) scale(1.1); }
    100% { transform: translate(3%, -4%) scale(1.05); }
  }

  @keyframes mesh-drift-2 {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(-6%, 8%) scale(0.95); }
    100% { transform: translate(-3%, 4%) scale(1.08); }
  }

  @keyframes mesh-drift-3 {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(5%, -6%) scale(1.12); }
    100% { transform: translate(-4%, -2%) scale(0.98); }
  }

  @keyframes mesh-drift-4 {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(7%, 3%) scale(1.05); }
    100% { transform: translate(-5%, 6%) scale(1.1); }
  }

  :global([data-theme="light"]) .mesh-1 {
    background: radial-gradient(circle, rgba(124, 110, 224, 0.25) 0%, transparent 70%);
  }
  :global([data-theme="light"]) .mesh-2 {
    background: radial-gradient(circle, rgba(167, 155, 240, 0.2) 0%, transparent 70%);
  }
  :global([data-theme="light"]) .mesh-3 {
    background: radial-gradient(circle, rgba(232, 121, 168, 0.15) 0%, transparent 70%);
  }
  :global([data-theme="light"]) .mesh-4 {
    background: radial-gradient(circle, rgba(110, 231, 200, 0.12) 0%, transparent 70%);
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .mesh-1 {
      background: radial-gradient(circle, rgba(124, 110, 224, 0.25) 0%, transparent 70%);
    }
    :global(:root:not([data-theme])) .mesh-2 {
      background: radial-gradient(circle, rgba(167, 155, 240, 0.2) 0%, transparent 70%);
    }
    :global(:root:not([data-theme])) .mesh-3 {
      background: radial-gradient(circle, rgba(232, 121, 168, 0.15) 0%, transparent 70%);
    }
    :global(:root:not([data-theme])) .mesh-4 {
      background: radial-gradient(circle, rgba(110, 231, 200, 0.12) 0%, transparent 70%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mesh-layer { animation: none; }
  }
</style>
