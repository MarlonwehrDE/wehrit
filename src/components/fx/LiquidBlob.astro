---
interface Props {
  color?: string;
  size?: string;
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
  opacity?: string;
  speed?: number;
  blur?: string;
  class?: string;
}

const {
  color = 'var(--color-primary-400)',
  size = '500px',
  top,
  left,
  right,
  bottom,
  opacity = '0.4',
  speed = 1,
  blur = '80px',
  class: className = '',
} = Astro.props;

const animDuration = `calc(var(--liquid-drift) * ${speed})`;
---

<div
  class:list={['liquid-blob', className]}
  aria-hidden="true"
  style={`
    --blob-color: ${color};
    --blob-size: ${size};
    --blob-opacity: ${opacity};
    --blob-blur: ${blur};
    --blob-anim-duration: ${animDuration};
    ${top ? `top: ${top};` : ''}
    ${left ? `left: ${left};` : ''}
    ${right ? `right: ${right};` : ''}
    ${bottom ? `bottom: ${bottom};` : ''}
  `}
/>

<style>
  .liquid-blob {
    position: absolute;
    width: var(--blob-size);
    height: var(--blob-size);
    background:
      radial-gradient(circle at 35% 40%, rgba(255, 255, 255, 0.15), transparent 50%),
      radial-gradient(circle, var(--blob-color) 0%, color-mix(in srgb, var(--blob-color), transparent 40%) 40%, transparent 70%);
    filter: blur(var(--blob-blur));
    opacity: var(--blob-opacity);
    pointer-events: none;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    animation: blob-morph var(--blob-anim-duration) ease-in-out infinite alternate;
  }

  @keyframes blob-morph {
    0%   { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; transform: rotate(0deg); }
    25%  { border-radius: 50% 50% 40% 60% / 60% 40% 50% 50%; }
    50%  { border-radius: 60% 40% 50% 50% / 50% 60% 40% 60%; transform: rotate(90deg); }
    75%  { border-radius: 45% 55% 60% 40% / 55% 45% 55% 45%; }
    100% { border-radius: 35% 65% 55% 45% / 45% 55% 65% 35%; transform: rotate(180deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .liquid-blob { animation: none; }
  }
</style>
