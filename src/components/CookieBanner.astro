---
---

<div class="cookie-banner" id="cookie-banner" role="dialog" aria-label="Cookie-Einstellungen" aria-hidden="true">
  <div class="cookie-banner-backdrop" id="cookie-backdrop"></div>
  <div class="cookie-banner-card glass-thick">
    <div class="glass-inner-layers">
      <div class="glass-specular" />
      <div class="glass-fresnel" />
    </div>
    <div class="glass-card-content">
      <h3 class="cookie-title">Datenschutz-Einstellungen</h3>
      <p class="cookie-desc">
        Diese Website verwendet technisch notwendige Funktionen (z.&nbsp;B. Speicherung Ihrer Theme-Einstellung). Optionale Dienste werden nur mit Ihrer Einwilligung aktiviert.
        Mehr Informationen finden Sie in der <a href="/datenschutz">Datenschutzerkl&auml;rung</a>.
      </p>

      <div class="cookie-categories">
        <label class="cookie-category">
          <div class="category-info">
            <span class="category-name">Technisch notwendig</span>
            <span class="category-desc">Theme-Einstellung (localStorage)</span>
          </div>
          <input type="checkbox" checked disabled />
          <span class="toggle toggle-required"></span>
        </label>

        <label class="cookie-category">
          <div class="category-info">
            <span class="category-name">Analyse &amp; Statistik</span>
            <span class="category-desc">Aktuell keine Dienste aktiv</span>
          </div>
          <input type="checkbox" id="consent-analytics" />
          <span class="toggle"></span>
        </label>

        <label class="cookie-category">
          <div class="category-info">
            <span class="category-name">Marketing</span>
            <span class="category-desc">Aktuell keine Dienste aktiv</span>
          </div>
          <input type="checkbox" id="consent-marketing" />
          <span class="toggle"></span>
        </label>
      </div>

      <div class="cookie-actions">
        <button class="cookie-btn cookie-btn-accept" id="cookie-accept-all" type="button">Alle akzeptieren</button>
        <button class="cookie-btn cookie-btn-save" id="cookie-save" type="button">Auswahl speichern</button>
        <button class="cookie-btn cookie-btn-reject" id="cookie-reject" type="button">Nur notwendige</button>
      </div>
    </div>
  </div>
</div>

<button class="cookie-settings-trigger glass-thin" id="cookie-settings-trigger" type="button" aria-label="Cookie-Einstellungen &ouml;ffnen" title="Cookie-Einstellungen">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
  </svg>
</button>

<style>
  .cookie-banner {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--space-4);
    visibility: hidden;
    pointer-events: none;
  }

  .cookie-banner[aria-hidden="false"] {
    visibility: visible;
    pointer-events: auto;
  }

  .cookie-banner-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition:
      backdrop-filter 0.3s var(--ease-glass),
      -webkit-backdrop-filter 0.3s var(--ease-glass),
      background 0.3s var(--ease-glass);
  }

  .cookie-banner[aria-hidden="false"] .cookie-banner-backdrop {
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgba(0, 0, 0, 0.4);
  }

  .cookie-banner-card {
    position: relative;
    width: 100%;
    max-width: 620px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: var(--radius-xl);
    transform: translateY(20px);
    opacity: 0;
    transition:
      transform 0.35s var(--ease-spring),
      opacity 0.35s var(--ease-glass);
    transition-delay: 0s;
  }

  .cookie-banner-card :global(.glass-card-content) {
    padding: var(--space-10) var(--space-12);
  }

  .cookie-banner[aria-hidden="false"] .cookie-banner-card {
    transform: translateY(0);
    opacity: 1;
    transition-delay: 0.15s;
  }

  .cookie-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .cookie-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
  }

  .cookie-desc a {
    color: var(--color-primary-400);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-categories {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .cookie-category {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--glass-bg-thin);
    border: 1px solid var(--glass-border-subtle);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .cookie-category:hover {
    border-color: var(--glass-border-medium);
  }

  .category-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .category-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .category-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .cookie-category input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle {
    position: relative;
    flex-shrink: 0;
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--glass-border-medium);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .toggle::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-text-muted);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  input:checked + .toggle {
    background: var(--color-primary-400);
    border-color: var(--color-primary-400);
  }

  input:checked + .toggle::after {
    transform: translateX(20px);
    background: white;
  }

  .toggle-required {
    opacity: 0.6;
  }

  input:disabled + .toggle {
    cursor: not-allowed;
  }

  .cookie-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cookie-btn {
    flex: 1;
    min-width: 140px;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    border: 1px solid var(--glass-border-medium);
    transition: all 0.2s ease;
  }

  .cookie-btn-accept {
    background: var(--color-primary-400);
    color: white;
    border-color: var(--color-primary-400);
  }

  .cookie-btn-accept:hover {
    background: var(--color-primary-300);
    border-color: var(--color-primary-300);
  }

  .cookie-btn-save {
    background: var(--glass-bg-thin);
    color: var(--color-text);
  }

  .cookie-btn-save:hover {
    background: var(--glass-bg-medium);
  }

  .cookie-btn-reject {
    background: transparent;
    color: var(--color-text-secondary);
  }

  .cookie-btn-reject:hover {
    background: var(--glass-bg-thin);
    color: var(--color-text);
  }

  .cookie-settings-trigger {
    position: fixed;
    bottom: var(--space-4);
    left: var(--space-4);
    z-index: 9999;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cookie-settings-trigger.visible {
    opacity: 1;
    visibility: visible;
  }

  .cookie-settings-trigger:hover {
    color: var(--color-primary-400);
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) .cookie-banner-backdrop {
      background: rgba(255, 255, 255, 0.3);
    }
    :root:not([data-theme]) .toggle {
      background: rgba(0, 0, 0, 0.1);
    }
  }

  :global([data-theme="light"]) .cookie-banner[aria-hidden="false"] .cookie-banner-backdrop {
    background: rgba(0, 0, 0, 0.15);
  }

  :global([data-theme="light"]) .toggle {
    background: rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 768px) {
    .cookie-banner-card :global(.glass-card-content) {
      padding: var(--space-8) var(--space-8);
    }
  }

  @media (max-width: 480px) {
    .cookie-banner-card :global(.glass-card-content) {
      padding: var(--space-6) var(--space-6);
    }

    .cookie-btn {
      min-width: 0;
      flex-basis: 100%;
    }
  }
</style>

<script>
  const CONSENT_KEY = 'wehrit-consent';

  interface ConsentState {
    necessary: boolean;
    analytics: boolean;
    marketing: boolean;
    timestamp: string;
  }

  function getConsent(): ConsentState | null {
    try {
      const raw = localStorage.getItem(CONSENT_KEY);
      if (!raw) return null;
      return JSON.parse(raw);
    } catch {
      return null;
    }
  }

  function setConsent(state: ConsentState): void {
    localStorage.setItem(CONSENT_KEY, JSON.stringify(state));
  }

  function showBanner(): void {
    const banner = document.getElementById('cookie-banner');
    if (banner) {
      banner.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function hideBanner(): void {
    const banner = document.getElementById('cookie-banner');
    if (banner) {
      banner.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    const trigger = document.getElementById('cookie-settings-trigger');
    if (trigger) trigger.classList.add('visible');
  }

  function saveAndClose(analytics: boolean, marketing: boolean): void {
    const state: ConsentState = {
      necessary: true,
      analytics,
      marketing,
      timestamp: new Date().toISOString(),
    };
    setConsent(state);
    hideBanner();
  }

  function init(): void {
    const consent = getConsent();
    const banner = document.getElementById('cookie-banner');
    const trigger = document.getElementById('cookie-settings-trigger');
    const analyticsBox = document.getElementById('consent-analytics') as HTMLInputElement | null;
    const marketingBox = document.getElementById('consent-marketing') as HTMLInputElement | null;

    if (consent) {
      if (analyticsBox) analyticsBox.checked = consent.analytics;
      if (marketingBox) marketingBox.checked = consent.marketing;
      if (trigger) trigger.classList.add('visible');
    } else {
      showBanner();
    }

    document.getElementById('cookie-accept-all')?.addEventListener('click', () => {
      if (analyticsBox) analyticsBox.checked = true;
      if (marketingBox) marketingBox.checked = true;
      saveAndClose(true, true);
    });

    document.getElementById('cookie-save')?.addEventListener('click', () => {
      saveAndClose(analyticsBox?.checked ?? false, marketingBox?.checked ?? false);
    });

    document.getElementById('cookie-reject')?.addEventListener('click', () => {
      if (analyticsBox) analyticsBox.checked = false;
      if (marketingBox) marketingBox.checked = false;
      saveAndClose(false, false);
    });

    trigger?.addEventListener('click', () => {
      const existing = getConsent();
      if (existing && analyticsBox) analyticsBox.checked = existing.analytics;
      if (existing && marketingBox) marketingBox.checked = existing.marketing;
      showBanner();
    });

    document.getElementById('cookie-backdrop')?.addEventListener('click', () => {
      const existing = getConsent();
      if (existing) hideBanner();
    });
  }

  init();
</script>
