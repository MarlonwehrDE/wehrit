---
import GlassCard from './ui/GlassCard.astro';
import LiquidBlob from './fx/LiquidBlob.astro';

const stats = [
  { label: 'aktiv seit', value: 2020, prefix: '', suffix: '', icon: '📅', noAnimate: true },
  { label: 'Langzeitkunden', value: 2, prefix: '', suffix: '', icon: '🤝' },
  { label: 'Ladezeiten', value: 1, prefix: '<', suffix: 's', icon: '⚡' },
  { label: 'Prozesse automatisiert', value: 50, prefix: '', suffix: '+', icon: '⚙' },
];
---

<section class="stats-section">
  <LiquidBlob color="var(--color-primary-600)" size="600px" top="-10%" right="5%" opacity="0.25" speed={1.3} />

  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-label">In Zahlen</span>
      <h2 class="section-title">Qualität, die man messen kann</h2>
    </div>

    <div class="stats-grid" data-reveal>
      {stats.map((s, i) => (
        <GlassCard level="medium" interactive tilt data-reveal>
          <div class="stat-icon">{s.icon}</div>
          <span class="stat-value">
            <span class="stat-prefix">{s.prefix}</span>
            {s.noAnimate ? (
              <span class="stat-number">{s.value}</span>
            ) : (
              <span class="stat-number" data-count-to={s.value} data-count-delay={i * 150}>0</span>
            )}
            <span class="stat-suffix">{s.suffix}</span>
          </span>
          <span class="stat-label">{s.label}</span>
        </GlassCard>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-section {
    position: relative;
    padding: var(--space-24) 0;
    overflow: visible;
  }

  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary-400);
    margin-bottom: var(--space-4);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-text), var(--color-primary-300));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-icon {
    font-size: 1.5rem;
    margin-bottom: var(--space-3);
  }

  .stat-value {
    display: block;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-primary-300), var(--color-iris-cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat-prefix,
  .stat-suffix {
    font-size: 0.6em;
    opacity: 0.7;
  }

  .stat-label {
    display: block;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 500;
  }
</style>

<script>
  function animateCounters() {
    const counters = document.querySelectorAll<HTMLElement>('[data-count-to]');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        observer.unobserve(el);

        const target = parseInt(el.dataset.countTo!, 10);
        const delay = parseInt(el.dataset.countDelay || '0', 10);
        const duration = 1800;

        setTimeout(() => {
          const start = performance.now();
          function step(now: number) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 4);
            el.textContent = Math.round(eased * target).toString();
            if (progress < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }, delay);
      });
    }, { threshold: 0.3 });

    counters.forEach((c) => observer.observe(c));
  }

  animateCounters();
</script>
