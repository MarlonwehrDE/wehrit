---
import GlassButton from './ui/GlassButton.astro';
import LiquidBlob from './fx/LiquidBlob.astro';
---

<section class="contact-cta" id="kontakt-cta">
  <LiquidBlob color="var(--color-primary-400)" size="500px" top="-20%" left="50%" opacity="0.3" speed={0.9} />

  <div class="container" data-reveal>
    <div class="cta-card glass-thick glass-interactive">
      <div class="glass-inner-layers">
        <div class="glass-specular" />
        <div class="glass-fresnel" />
        <div class="glass-light" />
      </div>
      <div class="cta-content">
        <span class="cta-label">Bereit loszulegen?</span>
        <h2 class="cta-title">Lass uns dein nächstes<br />Projekt besprechen.</h2>
        <p class="cta-desc">
          Ob neue Website, individuelle Software oder E-Rechnungs-Umstellung — ich freue mich auf deine Anfrage.
        </p>
        <div class="cta-actions">
          <GlassButton variant="primary" data-contact-modal>Jetzt Kontakt aufnehmen</GlassButton>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    position: relative;
    padding: var(--space-24) 0;
    overflow: visible;
  }

  .cta-card {
    position: relative;
    overflow: visible;
    text-align: center;
    border-radius: var(--radius-lg);
  }

  .cta-content {
    position: relative;
    z-index: 4;
    padding: var(--space-16) var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .cta-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary-400);
  }

  .cta-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: var(--leading-snug);
    background: linear-gradient(135deg, var(--color-text), var(--color-primary-300));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cta-desc {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    max-width: 500px;
    line-height: var(--leading-normal);
  }

  .cta-actions {
    margin-top: var(--space-6);
  }
</style>
